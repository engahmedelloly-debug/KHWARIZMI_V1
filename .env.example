# Set these as environment variables in your hosting provider. The app does not load .env automatically.
NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Point this to persistent storage on your host.
DB_FILE=./kharazmi.sqlite
# Same-origin deployment does not require CORS. If separated, set the exact frontend origin.
CORS_ORIGIN=http://localhost:3000
